{
  "(?<=\\d)\\s*сек\\.?": " секунд",
  "(?<=\\d)\\s*с\\.?": " секунд",
  "(?<=\\d)\\s*мин\\.?": " минут",
  "(?<=\\d)\\s*м\\.?": " минут",
  "(?<=\\d)\\s*ч\\.?": " час",
  "\\bсек\\.?\\b": "секунд",
  "\\bс\\.?\\b": "секунд",
  "\\bмин\\.?\\b": "минут",
  "\\bм\\.?\\b": "минут",
  "\\bч\\.?\\b": "час",
  "\\b(часа|часов)\\b": "час"
}
